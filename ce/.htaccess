# =========================================================
# サーキュラーエコノミーラボ 公式サイト（ce.llschema.com）
# ConoHa WING（LiteSpeed）用の設定
#
# 以前 Netlify に置いていたときの netlify.toml の役割を
# こちらに移したものです。
# =========================================================

# ---- 404ページ -------------------------------------------
ErrorDocument 404 /404.html

# ---- ディレクトリ一覧を出さない ---------------------------
Options -Indexes

DirectoryIndex index.html

# ---- 文字コード ------------------------------------------
AddDefaultCharset UTF-8

# ---- セキュリティヘッダー ---------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- キャッシュ ------------------------------------------
# 画像・CSS・JSは長めに。差し替えるときはファイル名を変える運用にしてください。
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType text/css                "access plus 1 day"
  ExpiresByType text/javascript         "access plus 1 day"
  ExpiresByType application/javascript  "access plus 1 day"
  # データJSONは更新頻度が高いのでキャッシュしない
  ExpiresByType application/json        "access plus 0 seconds"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- 常時SSL ---------------------------------------------
# ConoHa WING のコントロールパネルに「無料独自SSL」＋「常時SSL化」の
# 設定があるので、まずはそちらをONにしてください。
# パネル側で対応できない場合のみ、下の3行のコメントを外します。
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
