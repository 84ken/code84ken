# 検索エンジンに載せない（HTML・PDF・画像すべて対象）
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# members.html / docs.html のみBasic認証
<FilesMatch "^(members|docs)\.html$">
  AuthType Basic
  AuthName "中山田青少年育成会 会員専用"
  AuthUserFile /home/c4244218/public_html/nakayamada.schema.tokyo/.htpasswd
  require valid-user
</FilesMatch>
